{
  "entities": {
    "AiTool": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AiTool",
      "type": "object",
      "description": "Represents an AI tool listed on the platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the AI Tool entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the AI tool."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the AI tool's functionality and features."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to Category. (Relationship: Category 1:N AiTool)"
        },
        "link": {
          "type": "string",
          "description": "URL to access the AI tool.",
          "format": "uri"
        },
        "averageRating": {
          "type": "number",
          "description": "The average rating of the AI tool based on user reviews.",
          "format": "float"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "categoryId",
        "link"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a category of AI tools.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the category (e.g., Video, Photo, Text)."
        },
        "description": {
          "type": "string",
          "description": "A description of the category."
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Review",
      "type": "object",
      "description": "Represents a user review for an AI tool.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Review entity."
        },
        "aiToolId": {
          "type": "string",
          "description": "Reference to AiTool. (Relationship: AiTool 1:N Review)"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Review). Note: Assuming User data is managed externally (Auth0, Firebase Auth, etc.)."
        },
        "rating": {
          "type": "number",
          "description": "The rating given by the user (e.g., 1 to 5 stars)."
        },
        "comment": {
          "type": "string",
          "description": "The user's comment or feedback about the AI tool."
        },
        "dateCreated": {
          "type": "string",
          "description": "The date and time when the review was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "aiToolId",
        "userId",
        "rating",
        "comment",
        "dateCreated"
      ]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "A user-created community for sharing AI tools.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "memberCount": { "type": "number" },
        "isPublic": { "type": "boolean", "default": true }
      },
      "required": ["name", "description", "ownerId", "createdAt"]
    },
    "GroupTool": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GroupTool",
      "type": "object",
      "description": "An AI tool that has been added to a group.",
      "properties": {
        "id": { "type": "string" },
        "toolName": { "type": "string" },
        "toolUrl": { "type": "string", "format": "uri" },
        "toolDescription": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" },
        "upvotes": { "type": "number", "default": 0 }
      },
      "required": ["toolName", "toolUrl", "addedBy", "addedAt"]
    },
    "GroupMember": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "GroupMember",
        "type": "object",
        "description": "Represents a user's membership in a group.",
        "properties": {
            "userId": { "type": "string" },
            "joinedAt": { "type": "string", "format": "date-time" },
            "role": { "type": "string", "enum": ["owner", "admin", "member"] }
        },
        "required": ["userId", "joinedAt", "role"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Stores AI tool categories."
        }
      },
      {
        "path": "/ai_tools/{aiToolId}",
        "definition": {
          "entityName": "AiTool",
          "schema": { "$ref": "#/backend/entities/AiTool" },
          "description": "Stores the details of each AI tool."
        }
      },
      {
        "path": "/ai_tools/{aiToolId}/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": { "$ref": "#/backend/entities/Review" },
          "description": "Stores user reviews for each AI tool."
        }
      },
      {
          "path": "/groups/{groupId}",
          "definition": {
              "entityName": "Group",
              "schema": { "$ref": "#/backend/entities/Group" },
              "description": "Stores information about user-created clubs."
          }
      },
      {
          "path": "/groups/{groupId}/members/{userId}",
          "definition": {
              "entityName": "GroupMember",
              "schema": { "$ref": "#/backend/entities/GroupMember" },
              "description": "Stores members of a club."
          }
      },
      {
          "path": "/groups/{groupId}/tools/{groupToolId}",
          "definition": {
              "entityName": "GroupTool",
              "schema": { "$ref": "#/backend/entities/GroupTool" },
              "description": "Stores AI tools added to a club."
          }
      }
    ]
  }
}
