/**
 * Core Philosophy: This ruleset supports a public-facing catalog of AI tools that authenticated users can review.
 * It enforces a model where catalog data (categories, tools) is publicly readable but not client-writable,
 * treating it as admin-managed content. User-generated content (reviews) is publicly readable, but can only be
 * created, modified, or deleted by the user who owns it.
 *
 * Data Structure: The data is organized into two top-level collections, `/categories` and `/ai_tools`, which are
 * intended for public discovery. Each tool document in `/ai_tools` can contain a `/reviews` subcollection for
 * user-submitted reviews.
 *
 * Key Security Decisions:
 * - Public Read-Only Catalog: The `/categories` and `/ai_tools` collections are readable by anyone, including
 *   unauthenticated users, to facilitate browsing. All client write operations are disabled to protect the integrity
 *   of the catalog data.
 * - User-Owned Reviews: A user must be signed in to write a review. They have full control (create, update, delete)
 *   over their own reviews, enforced by matching their `request.auth.uid` with the `userId` field on the review document.
 * - No User Listing: The rules do not support listing all users of the platform.
 *
 * Denormalization for Authorization: The security model relies on a denormalized `userId` field within each `review`
 * document. This allows for simple, performant ownership checks (`resource.data.userId == request.auth.uid`) without
 * needing to perform extra reads on other documents.
 *
 * Structural Segregation: The separation of public catalog data (`/ai_tools`) from user-generated content
 * (`.../reviews`) into a subcollection provides a clear and secure structure for applying different access rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for safe updates and deletes.
     * Ensures the request is authenticated, the user is the owner, and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    /**
     * @description Controls access to the AI tool categories. Categories are public and read-only for clients.
     * @path /categories/{categoryId}
     * @allow (get) Anyone, including unauthenticated users, can read a specific category.
     * @deny (create) A client attempts to create a new category document.
     * @principle Protects publicly readable, admin-managed reference data from unauthorized modification.
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to AI tool documents. AI tools are public and read-only for clients.
     * @path /ai_tools/{aiToolId}
     * @allow (get) Anyone, including unauthenticated users, can view the details of an AI tool.
     * @deny (update) A client attempts to change the description of an AI tool.
     * @principle Protects publicly readable, admin-managed catalog data from unauthorized modification.
     */
    match /ai_tools/{aiToolId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      /**
       * @description Controls access to reviews for a specific AI tool. Reviews are public to read, but writes are restricted to owners.
       * @path /ai_tools/{aiToolId}/reviews/{reviewId}
       * @allow (create) An authenticated user (uid: 'user123') creates a review with `{ userId: 'user123', ... }`.
       * @deny (update) A user ('user456') tries to update a review owned by 'user123'.
       * @principle Enforces strict document ownership for user-generated content.
       */
      match /reviews/{reviewId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(resource.data.userId);
      }
    }
  }
}