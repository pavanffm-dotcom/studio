/**
 * Core Philosophy: This ruleset supports a public-facing catalog of AI tools that authenticated users can review.
 * It also supports user-created groups (Clubs) where members can share and vote on tools.
 *
 * Data Structure:
 * - Public data: `/categories`, `/ai_tools` are publicly readable, admin-managed.
 * - User data: `/users/{userId}` for personal preferences like hearted/starred tools.
 * - Community data: `/groups/{groupId}` for club information, with subcollections for members and tools.
 *
 * Key Security Decisions:
 * - Public Read-Only Catalog: `/categories` and `/ai_tools` are world-readable, client-writable false.
 * - User-Owned Data: A user must be signed in to manage their own `heartedTools` and `starredTools`.
 * - Community Groups (Clubs):
 *   - Authenticated users can create new groups.
 *   - Public groups are readable by anyone.
 *   - Only the group owner can edit or delete the group.
 *   - Members can be added/managed (future implementation).
 *   - Members can add tools to a group.
 *   - Members can upvote tools within a group (future implementation).
 *   - Members can send messages in a group chat.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    function isGroupOwner(groupId) {
      return isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }
    
    function isGroupMember(groupId) {
      // A user is a member if they exist in the members subcollection OR if the group is public.
      return isSignedIn() && (
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/groups/$(groupId)).data.isPublic == true
      );
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /ai_tools/{aiToolId} {
      allow get, list: if true;
      allow write: if false;

      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(resource.data.userId);
      }
    }
    
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn();
      allow delete: if false;
    }

    //-------------------------------------------------------------------------
    // Community (Clubs) Rules
    //-------------------------------------------------------------------------
    
    match /groups/{groupId} {
      // Anyone can read public groups
      allow get: if resource.data.isPublic == true || isGroupMember(groupId);
      // Any signed-in user can list all groups (for the community page)
      allow list: if isSignedIn();
      // Any signed-in user can create a group, making them the owner
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Only the owner can update or delete the group
      allow update, delete: if isGroupOwner(groupId);

      // Rules for group members subcollection
      match /members/{userId} {
        // Only owner can add/remove members (or members can join/leave public groups)
        allow read, write: if isGroupOwner(groupId) || isOwner(userId);
      }

      // Rules for tools shared within a group
      match /tools/{groupToolId} {
        allow get, list: if true; // Anyone can see tools in a public group
        // Only a group member can add a tool
        allow create: if isGroupMember(groupId) && request.resource.data.addedBy == request.auth.uid;
        // Only the user who added the tool or the group owner can delete it
        allow delete: if isGroupMember(groupId) && (resource.data.addedBy == request.auth.uid || isGroupOwner(groupId));
        // Members can upvote (future implementation)
        allow update: if isGroupMember(groupId);
      }

      // Rules for chat messages within a group
      match /messages/{messageId} {
        allow list, get: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isGroupOwner(groupId) || isOwner(resource.data.userId);
      }
    }
  }
}
