/**
 * Core Philosophy: This ruleset supports a public-facing catalog of AI tools that authenticated users can review.
 * It enforces a model where catalog data (categories, tools) is publicly readable but not client-writable,
 * treating it as admin-managed content. User-generated content (reviews, favourites) is publicly readable, but can only be
 * created, modified, or deleted by the user who owns it.
 *
 * Data Structure: The data is organized into top-level collections like `/categories` and `/ai_tools`,
 * and a `/users` collection for user-specific data. Each user document can contain subcollections
 * like `/favourites`.
 *
 * Key Security Decisions:
 * - Public Read-Only Catalog: The `/categories` and `/ai_tools` collections are readable by anyone.
 *   All client write operations are disabled to protect data integrity.
 * - User-Owned Data: A user must be signed in to write reviews or manage their favourites.
 *   They have full control over their own data, enforced by matching `request.auth.uid` with the document path or a `userId` field.
 * - No User Listing: The rules do not support listing all users of the platform.
 *
 * Denormalization for Authorization: The security model relies on a denormalized `userId` field within `review`
 * documents. For `favourites`, ownership is determined by the document path itself (`/users/{userId}/...`).
 *
 * Structural Segregation: The separation of public data from user-specific data provides a clear structure
 * for applying different access rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for safe updates and deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    /**
     * @description Controls access to the AI tool categories. Categories are public and read-only for clients.
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }

    /**
     * @description Controls access to AI tool documents. AI tools are public and read-only for clients.
     */
    match /ai_tools/{aiToolId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;

      /**
       * @description Controls access to reviews for a specific AI tool.
       */
      match /reviews/{reviewId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(resource.data.userId);
      }
    }
    
    /**
     * @description Controls access to user-specific data, including saved and starred tools.
     */
    match /users/{userId} {
      // Users can read their own document.
      // They can create it, and update their hearted/starred tools.
      allow read: if isOwner(userId);
      allow create: if isSignedIn();
      allow update: if isOwner(userId);
      // Disallow client-side deletion of the main user document for safety.
      allow delete: if false;
    }
  }
}
